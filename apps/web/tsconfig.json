{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@core/query": ["../../packages/core/src/query/parse.ts"],
      "@core/sources": ["../../packages/core/src/catalog/sources.ts"],
      "@core/workloads": ["../../packages/core/src/catalog/workloads.ts"],
      "@core/known": ["../../packages/core/src/catalog/known.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
